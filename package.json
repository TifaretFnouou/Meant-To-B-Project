{
  "name": "queenb-app",
  "version": "1.0.0",
  "private": true,
  "description": "A full-stack Node.js and React application",
  "main": "server/server.js",
  "scripts": {
    "predev": "node scripts/ensure-install.cjs",
    "dev": "concurrently -n server,client -c blue,magenta \"npm run server\" \"npm run client\"",
    "server": "npm run dev --prefix server",
    "client": "npm start --prefix client",
    "client:watch": "npm run watch --prefix client",
    "client:build:watch": "npm run build:watch --prefix client",
    "client:test:watch": "npm run test:watch --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "install-server": "npm install --prefix server",
    "install-client": "npm install --prefix client",
    "install-all": "npm run install:all",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "seed": "npm run seed --prefix server"
  },
  "keywords": [
    "nodejs",
    "react",
    "material-ui",
    "fullstack"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
