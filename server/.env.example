PORT=5001
JWT_SECRET=
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<db-name>
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
CLOUDINARY_URL=
